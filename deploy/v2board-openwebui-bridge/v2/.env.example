# Open WebUI OIDC配置示例
# 复制此文件为.env并根据您的实际情况修改

# 基本配置
WEBUI_PORT=3080
#DATA_DIR=./data

# OIDC配置
OAUTH_PROVIDER_NAME=V2Board
OPENID_PROVIDER_URL=https://your-v2board-domain/oauth/.well-known/openid-configuration
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OPENID_REDIRECT_URI=https://your-openwebui-domain/oauth/oidc/callback

# 角色管理配置（可选）
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=roles
OAUTH_ALLOWED_ROLES=user
OAUTH_ADMIN_ROLES=admin

# 组管理配置（可选）
ENABLE_OAUTH_GROUP_MANAGEMENT=true
OAUTH_GROUP_CLAIM=groups